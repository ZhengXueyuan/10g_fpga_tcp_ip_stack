+        //   ⛔ 为什么不判其它模式: H/H10 无这些端口 (结构性); OFF 是常量门 (折叠 ⇒ DUT
+        //      恒 0, 换成 W6o 折叠见证 + 正控, 见下); M6/M6B/M7 的红集由既有判据承担
+        //      (突变下事件语义本就不同, 拿 W3..W5 去判会把"突变的预期行为"误报成 errs)。
+`ifdef P9_SWC_ARM
+  `ifdef P9_EXP_FIXED
+        begin : e12_checks
+            integer sum_req, sum_pend, sum_upn;
+            sum_req = 0; sum_pend = 0; sum_upn = 0;
+            for (ii = 0; ii < NALL; ii = ii + 1) begin
+                sum_req  = sum_req  + w_srq[ii];
+                sum_pend = sum_pend + w_sup[ii];
+                sum_upn  = sum_upn  + M_upn[ii];
+                $sformat(lbl, "W3 arm%0d stat_up_ev == TB ev_up count (dut=%0d tb=%0d)", ii, w_uev[ii], M_upn[ii]);
+                chk(w_uev[ii] === M_upn[ii], lbl);
+                $sformat(lbl, "W4 arm%0d stat_sw_apply == TB sw_apply count (dut=%0d tb=%0d)", ii, w_sap[ii], M_swac[ii]);
+                chk(w_sap[ii] === M_swac[ii], lbl);
+                $sformat(lbl, "W5 arm%0d req/pend class (dut srq=%0d/sup=%0d tb req=%0d/pend=%0d)",
+                         ii, w_srq[ii], w_sup[ii], M_req[ii], M_pend[ii]);
+                chk((w_srq[ii] === M_req[ii]) && (w_sup[ii] === M_pend[ii]), lbl);
+            end
+            $sformat(lbl, "W6 E12 non-vacuous (sum srq=%0d>=1, sum sup=%0d>=1, TB ev_up=%0d>=1)",
+                     sum_req, sum_pend, sum_upn);
+            chk((sum_req >= 1) && (sum_pend >= 1) && (sum_upn >= 1), lbl);
+        end
+  `endif
+`endif
+`ifdef P9_SWC_OFF
+        // 常量门负对照的正控读数: DUT 四计数器必须**全 0** (SWC_OK=0 折叠),
+        //   而同一条激励在 TB 侧数出的事件数 > 0 ⇒ 这个 0 不是"没激励"造成的空真。
+        begin : e12_fold
+            integer sum_dut, sum_upn_off;
+            sum_dut = 0; sum_upn_off = 0;
+            for (ii = 0; ii < NALL; ii = ii + 1) begin
+                sum_dut     = sum_dut     + w_uev[ii] + w_srq[ii] + w_sap[ii] + w_sup[ii];
+                sum_upn_off = sum_upn_off + M_upn[ii];
+            end
+            $sformat(lbl, "W6o OFF-mode E12 counters structurally folded (SWC_OK=0): sum=%0d", sum_dut);
+            chk(sum_dut === 0, lbl);
+            $sformat(lbl, "W6p OFF-mode positive control: TB-observed ev_up = %0d (>0 => W6o is not vacuous)", sum_upn_off);
+            chk(sum_upn_off > 0, lbl);
+        end
+`endif
+`ifdef P9_HEAD_RTL
+        $display("  [ n/a ] W3..W6 E12 counter checks skipped (frozen head: no E12 ports)");
+`endif
+
         $display("TB_P9_SWC_SUM errs=%0d", errs);
         if (errs == 0) $display("TB_P9_SWC: OK");
         else           $display("TB_P9_SWC: FAIL errs=%0d", errs);
